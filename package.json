{
  "name": "dsh-omni-auto",
  "version": "0.1.0",
  "description": "Automatic OMNI distillation for DeepSeek Harness: rewrites oversized tool results through OMNI signal extraction at the tools/post-execute seam, so noisy output never enters the model context without the model choosing omni_run.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "omni",
    "context-efficiency"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  }
}
